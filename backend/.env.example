PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=taghuman
DB_USER=postgres
DB_PASSWORD=password

# Misma clave para firmar y verificar JWT
JWT_SECRET=cambia_esto_en_produccion

# Access corto (ej. 15m) y refresh largo en días
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_DAYS=7

# development: el token de recuperación se imprime en consola del backend
NODE_ENV=development
